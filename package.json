{
  "name": "edgerun-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "clean": "rm -rf dist",
    "brand:generate": "bun scripts/generate-brand-assets.mjs",
    "docs:generate": "bun scripts/generate-scheduler-docs.mjs",
    "blog:generate": "bun scripts/build-blog.mjs",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/assets/styles.css --minify",
    "build:js": "esbuild ./src/client.ts --bundle=false --format=esm --target=es2022 --outfile=./dist/assets/client.js",
    "build:html": "bun ./build.tsx",
    "build": "bun run brand:generate && bun run docs:generate && bun run clean && mkdir -p ../docs dist/assets && bun run build:css && bun run build:js && bun run build:html && bun run blog:generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "shiki": "^3.22.0",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/cli": "^4.2.0",
    "@types/markdown-it": "^14.1.2",
    "bun-types": "^1.3.9",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-solid": "^0.14.4",
    "esbuild": "^0.25.12",
    "globals": "^16.5.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
